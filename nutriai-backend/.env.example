# NutriAI Backend — local / demo
DEBUG=true
ENVIRONMENT=development
DEMO_MODE=true

SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DATABASE_URL=sqlite:///./nutriai.db

# Optional: legacy Labcorp portal integration (not required for open-market demo)
LABCORP_PORTAL_API_URL=
LABCORP_USE_MOCK=true

# Optional Okta (leave blank for demo email login)
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_REDIRECT_URI=

# AI keys (optional — improves chat coaching; plans work without these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# MyChart / health-record sync (future)
MYCHART_USE_MOCK=true
DEFAULT_HEALTH_SYSTEM=health_records
