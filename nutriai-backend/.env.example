# NutriAI Backend — local / open-market demo
DEBUG=true
ENVIRONMENT=development
DEMO_MODE=true

SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DATABASE_URL=sqlite:///./nutriai.db

# AI keys — optional but recommended for "any goal" demos
# With a key: free-text goals (skin/hair/jet lag/etc.) are interpreted by AI
# then the catalog engine builds the 7-day plan. Without a key: local heuristics.
# Prefer OpenAI gpt-4o-mini for cheap demos; Anthropic Haiku also supported.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Future automatic health-record sync (paste import is used for now)
DEFAULT_HEALTH_SYSTEM=health_records
