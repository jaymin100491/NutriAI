# NutriAI Backend — local / production
DEBUG=true
ENVIRONMENT=development
DEMO_MODE=true

# REQUIRED in production: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# sqlite for local/demo; use postgres://... for production
DATABASE_URL=sqlite:///./nutriai.db

# Comma-separated for production hosts (parsed if your host supports JSON list via env override)
# Keep Flutter web origin(s) here when DEBUG=false
# Example production: https://your-app.web.app,https://your-app.firebaseapp.com

# AI keys — optional but recommended for free-text goal interpretation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Future automatic health-record sync (PDF/paste import is used for now)
DEFAULT_HEALTH_SYSTEM=health_records
